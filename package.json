{
  "name": "@geril/configs",
  "version": "1.0.0",
  "description": "Reusable TypeScript, Oxlint, and Oxfmt configuration primitives.",
  "license": "MIT",
  "files": [
    "ts",
    "oxlint",
    "oxfmt",
    "plugins",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./ts/base": "./ts/base.json",
    "./ts/bundler": "./ts/bundler.json",
    "./ts/node": "./ts/node.json",
    "./oxlint/base": "./oxlint/base.js",
    "./oxlint/react": "./oxlint/react.js",
    "./oxlint/next": "./oxlint/next.js",
    "./oxlint/node": "./oxlint/node.js",
    "./oxlint/typed": "./oxlint/typed.js",
    "./oxlint/anti-slop": "./oxlint/anti-slop.js",
    "./oxlint": "./oxlint/index.js",
    "./oxfmt/base": "./oxfmt/base.js",
    "./oxfmt/tailwind": "./oxfmt/tailwind.js",
    "./oxfmt": "./oxfmt/index.js",
    "./plugin/anti-slop": {
      "types": "./plugins/anti-slop/index.d.ts",
      "import": "./plugins/anti-slop/index.js",
      "default": "./plugins/anti-slop/index.js"
    }
  },
  "scripts": {
    "build:anti-slop": "node scripts/build-anti-slop.mjs",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "oxfmt": ">=0.60.0",
    "oxlint": ">=1.81.0",
    "oxlint-tsgolint": ">=7.0.0",
    "typescript": ">=5.8.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
